# ==============================================================================
# AgentX Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=agentx
POSTGRES_USER=agentx
POSTGRES_PASSWORD=agentx
DATABASE_URL=postgres://agentx:agentx@localhost:5432/agentx

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Rust API
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0:8080

# JWT secret for signing authentication tokens (CHANGE IN PRODUCTION)
JWT_SECRET=agentx-dev-secret-change-in-production

# AES-256 encryption key for credential vault (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Allowed CORS origin (the frontend URL — set to your production domain when deploying)
CORS_ORIGIN=http://localhost:3000

# Rust log level filter
RUST_LOG=agentx_api=debug,tower_http=debug

# ------------------------------------------------------------------------------
# Python Analytics Service
# ------------------------------------------------------------------------------
ANALYTICS_HOST=0.0.0.0
ANALYTICS_PORT=8000

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000
